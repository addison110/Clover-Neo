<!-- The player with its controls in a bar at the bottom. The controls can only be replaced from
     XML, with controller_layout_id. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:controller_layout_id="@layout/video_player_controls_bottom"
    app:fastforward_icon="@drawable/ic_video_fast_forward_white_24dp"
    app:pause_icon="@drawable/ic_video_pause_white_24dp"
    app:play_icon="@drawable/ic_video_play_white_24dp"
    app:rewind_icon="@drawable/ic_video_rewind_white_24dp" />
